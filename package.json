{
  "name": "folder-sunburst-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.tsx",
  "module": "src/index.tsx",
  "scripts": {
    "build": "echo 'Build not configured'",
    "dev": "bun run src/index.tsx",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts,.tsx",
    "start": "NODE_ENV=production bun src/index.tsx",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nivo/core": "^0.92.0",
    "@nivo/sunburst": "^0.92.0",
    "@types/jest": "^29.5.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.0",
    "@eslint/css": "^0.7.0",
    "@eslint/js": "^9.25.1",
    "@eslint/json": "^0.12.0",
    "@eslint/markdown": "^6.4.0",
    "@types/bun": "latest",
    "@types/express": "^5.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.3",
    "bun-plugin-tailwind": "^0.0.14",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.2.5",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.31.1"
  }
}
